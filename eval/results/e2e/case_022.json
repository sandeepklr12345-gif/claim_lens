{
  "case_id": "case_022",
  "reason": "Rejected due to reduced Sum Insured at policy renewal.",
  "top_clauses": [
    {
      "chunk": {
        "chunk_id": "care_supreme-0042",
        "doc_id": "care_supreme",
        "text": "In the event of a Claim there is no impact on the accrual of Cumulative Bonus. In case Sum Insured under the Policy is reduced at the time of renewal, the applicable Cumulative Bonus shall be reduced in proportion to the Sum Insured. In case Sum Insured under the Policy is increased at the time of renewal, the Cumulative Bonus shall be calculated on the Sum Insured applicable on the last completed Policy Year. The 'Unlimited Automatic Recharge' and Optional Benefit: 'Plus Benefit' amount shall not be considered while calculating 'Cumulative Bonus'. Accrued 'Cumulative Bonus' can be utilized for Base Benefits- 'Hospitalization Expenses', ' Road Ambulance Cover' under the Policy.",
        "section_path": "3.1 BASE BENEFITS > 3.1.3 Benefit: Cumulative Bonus > (viii)",
        "page": 11
      },
      "score": 3.8419406414031982,
      "bm25_rank": 1,
      "dense_rank": 6
    },
    {
      "chunk": {
        "chunk_id": "care_supreme-0091",
        "doc_id": "care_supreme",
        "text": "Alterations in the Policy This Policy constitutes the complete contract of insurance. No change or alteration shall be valid or effective unless approved in writing by the Company, which approval shall be evidenced by a written endorsement signed and stamped by the Company. However, change or alteration with respect to increase/ decrease of the Sum Insured shall be permissible only at the time of renewal of the Policy. Out of all the details of the various Benefits provided in the Policy Terms and Conditions, only the details pertaining to Benefits chosen by policyholder as per Policy Schedule shall be considered relevant",
        "section_path": "5.24 Alterations in the Policy",
        "page": 26
      },
      "score": 2.2442119121551514,
      "bm25_rank": 8,
      "dense_rank": 1
    },
    {
      "chunk": {
        "chunk_id": "care_supreme-0040",
        "doc_id": "care_supreme",
        "text": "Benefit: Cumulative Bonus: At the end of each Policy Year, the Company will enhance the Sum Insured by 50% flat, on a cumulative basis, as a Cumulative Bonus for each completed and continuous Policy Year, and subject to the conditions specified below: In any Policy Year, the accrued Cumulative Bonus, shall not exceed 100% of the Sum Insured available in the expiring Policy or renewed Policy, wherever Sum Insured is lower. The entire Cumulative Bonus will be forfeited if the Policy is not continued / renewed on or before Policy Period End Date or the expiry of the Grace Period whichever is later.",
        "section_path": "3.1 BASE BENEFITS > 3.1.3 Benefit: Cumulative Bonus",
        "page": 11
